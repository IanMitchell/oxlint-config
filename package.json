{
	"name": "@0x57/oxlint-config",
	"version": "0.2.3",
	"description": "Shared oxlint configuration used by 0x57 projects",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/oxlint.config.d.ts",
			"default": "./dist/oxlint.config.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"format": "oxfmt",
		"lint": "oxlint",
		"build": "tsgo",
		"prepare": "bun run format && bun run build"
	},
	"devDependencies": {
		"@0x57/oxfmt-config": "1.0.7",
		"@0x57/typescript-config": "2.0.0",
		"@typescript/native-preview": "7.0.0-dev.20260512.1",
		"oxfmt": "0.55.0"
	},
	"peerDependencies": {
		"oxlint": "1.70.0"
	}
}
